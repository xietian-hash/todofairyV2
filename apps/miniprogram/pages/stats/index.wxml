<view class="page" style="padding-top: {{statusBarHeight + navBarHeight}}px">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px">
    <view class="custom-nav-bar" style="height: {{navBarHeight}}px">
      <view class="nav-back" bindtap="onBack">‹</view>
      <text class="nav-title">统计报表</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{errorText}}" class="error-bar">{{errorText}}</view>

  <!-- 主内容 -->
  <block wx:elif="{{overview}}">

    <!-- 概览三格 -->
    <view class="card-row">
      <view class="stat-card">
        <text class="stat-label">今日完成率</text>
        <text class="stat-value {{overview.today.completionRate >= 100 ? 'full' : ''}}">{{overview.today.completionRate}}%</text>
        <text class="stat-sub">{{overview.today.completed}}/{{overview.today.total}} 条</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">本周完成率</text>
        <text class="stat-value {{overview.week.completionRate >= 100 ? 'full' : ''}}">{{overview.week.completionRate}}%</text>
        <text class="stat-sub">{{overview.week.completed}}/{{overview.week.total}} 条</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">本月完成率</text>
        <text class="stat-value {{overview.month.completionRate >= 100 ? 'full' : ''}}">{{overview.month.completionRate}}%</text>
        <text class="stat-sub">{{overview.month.completed}}/{{overview.month.total}} 条</text>
      </view>
    </view>

    <!-- 打卡连续天数 -->
    <view class="section-card">
      <view class="section-title">连续打卡</view>
      <view class="streak-row">
        <view class="streak-item">
          <text class="streak-num">{{streak.current}}</text>
          <text class="streak-desc">当前连续（天）</text>
        </view>
        <view class="streak-divider"></view>
        <view class="streak-item">
          <text class="streak-num best">{{streak.longest}}</text>
          <text class="streak-desc">历史最长（天）</text>
        </view>
      </view>
      <text class="streak-tip">当天有未完成的待办才算打卡失败</text>
    </view>

    <!-- 30天趋势 -->
    <view class="section-card">
      <view class="section-title">近30天每日完成率</view>
      <view wx:if="{{trendDays.length === 0}}" class="empty-tip">暂无数据</view>
      <view wx:else class="chart-wrap">
        <view class="chart-bars">
          <view
            wx:for="{{trendDays}}"
            wx:key="date"
            class="chart-col"
          >
            <view
              class="chart-bar {{item.isEmpty ? 'bar-empty' : (item.isFull ? 'bar-full' : 'bar-partial')}}"
              style="height: {{item.barHeight}}%;"
            ></view>
          </view>
        </view>
        <view class="chart-axis-labels">
          <text class="axis-label">{{trendStartLabel}}</text>
          <text class="axis-label">{{trendEndLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 标签完成情况 -->
    <view class="section-card" wx:if="{{overview.tags.length > 0}}">
      <view class="section-title">按标签统计（本月）</view>
      <view wx:for="{{overview.tags}}" wx:key="tagName" class="tag-row">
        <view class="tag-row-header">
          <text class="tag-name">{{item.tagName}}</text>
          <text class="tag-rate">{{item.completionRate}}%（{{item.completed}}/{{item.total}}）</text>
        </view>
        <view class="progress-bg">
          <view class="progress-fill" style="width: {{item.completionRate}}%;"></view>
        </view>
      </view>
    </view>

  </block>
</view>
