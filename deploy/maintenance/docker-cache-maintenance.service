[Unit]
Description=清理超过七天未使用的 Docker 构建缓存
After=docker.service
ConditionPathExists=/var/run/docker.sock

[Service]
Type=oneshot
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=0 /run/docker-cache-maintenance.lock /usr/bin/docker builder prune --all --filter until=168h --keep-storage 2147483648 --force
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
