.cp-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 19999;
  display: flex;
  align-items: flex-end;
}

.cp-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.cp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx 20rpx;
}

.cp-nav-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #f1f5f9;
  font-size: 40rpx;
  color: #1e293b;
}

.cp-nav-btn:active {
  background: #e2e8f0;
}

.cp-month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.cp-week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.cp-day-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.cp-day-cell {
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: #f1f5f9;
  position: relative;
  box-sizing: border-box;
}

.cp-day-cell.cp-empty {
  background: transparent;
}

.cp-day-cell:active {
  opacity: 0.7;
}

.cp-day-num {
  line-height: 1;
}

.cp-today-dot {
  display: none;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #21bfff;
  margin-top: 3rpx;
}

.cp-day-cell.cp-today .cp-today-dot {
  display: block;
}

.cp-day-cell.cp-today .cp-day-num {
  color: #21bfff;
  font-weight: 600;
}

.cp-day-cell.cp-selected {
  background: linear-gradient(135deg, #e0f5ff, #ede9fe);
  font-weight: 600;
  border: 2rpx solid #21bfff;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.cp-day-cell.cp-today.cp-selected .cp-today-dot {
  background: #6c5ce7;
}

.cp-safe-bottom {
  height: env(safe-area-inset-bottom, 0px);
  min-height: 24rpx;
}
