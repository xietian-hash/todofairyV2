.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #f5f7fa;
}

.custom-nav-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: #64748b;
  background: #ffffff;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e293b;
  text-align: center;
}

/* 加载 & 错误 */
.loading-wrap {
  margin-top: 120rpx;
  display: flex;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #94a3b8;
}

.error-bar {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #ef4444;
  text-align: center;
}

/* 概览三格 */
.card-row {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
}

.stat-value {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.1;
}

.stat-value.full {
  color: #0d9488;
}

.stat-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* 通用卡片 */
.section-card {
  margin-top: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  padding: 28rpx 24rpx;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

/* 打卡连续 */
.streak-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.streak-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1;
}

.streak-num.best {
  color: #d97706;
}

.streak-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.streak-divider {
  width: 1rpx;
  height: 80rpx;
  background: #e2e8f0;
}

.streak-tip {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

/* 趋势图 */
.empty-tip {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  padding: 20rpx 0;
}

.chart-wrap {
  width: 100%;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  height: 140rpx;
  gap: 4rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  align-items: flex-end;
  height: 100%;
}

.chart-bar {
  width: 100%;
  border-radius: 4rpx 4rpx 0 0;
  min-height: 4rpx;
}

.bar-empty {
  background: #e2e8f0;
}

.bar-full {
  background: linear-gradient(180deg, #34d399, #0d9488);
}

.bar-partial {
  background: linear-gradient(180deg, #60a5fa, #3b82f6);
}

.chart-axis-labels {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
}

.axis-label {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 标签统计 */
.tag-row {
  margin-bottom: 20rpx;
}

.tag-row:last-child {
  margin-bottom: 0;
}

.tag-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.tag-name {
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
}

.tag-rate {
  font-size: 24rpx;
  color: #64748b;
}

.progress-bg {
  height: 12rpx;
  background: #f1f5f9;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #60a5fa, #6c5ce7);
  border-radius: 6rpx;
  transition: width 0.3s;
}
